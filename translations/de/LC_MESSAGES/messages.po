msgstr "Transporter bis 3,5 t + 1 Träger"

msgid "60 € / час"
msgstr "60 € / Std"

msgid "Стандарт"
msgstr "Standard"

msgid "Фургон + дополнительные грузчики, а также монтаж мебели по договорённости"
msgstr ""
"Transporter + zusätzliche Umzugshelfer sowie Möbelmontage nach "
"Vereinbarung"

msgid "от 80–100 € / час"
msgstr "ab 80–100 € / Std"

msgid "Межгород"
msgstr "Fernverkehr"

msgid "Фикс по маршруту..."
msgstr "Festpreis je Strecke, Nachtfenster möglich"

